{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arika0093/console2svg/main/docs/console2svg.schema.json",
  "title": "console2svg configuration",
  "description": "Configuration consumed by console2svg --config. Command-line arguments override these values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "include": { "type": "array", "items": { "type": "string" }, "description": "YAML files to load before this file, relative to this file." },
    "input": { "$ref": "#/$defs/input" },
    "output": { "$ref": "#/$defs/output" },
    "capture": { "$ref": "#/$defs/capture" },
    "video": { "$ref": "#/$defs/video" },
    "replay": { "$ref": "#/$defs/replay" },
    "conversion": { "$ref": "#/$defs/conversion" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "appearance": { "$ref": "#/$defs/appearance" }
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "properties": { "castPath": { "type": "string", "description": "asciicast input path." } }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "default": "output.svg" },
        "mode": { "enum": ["image", "video", "repeat"] },
        "stdOut": { "type": "boolean" },
        "saveFramesDir": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "width": { "type": "string" }, "height": { "type": "string" },
        "frame": { "type": "string" }, "time": { "type": "string" },
        "cropTop": { "type": "string" }, "cropRight": { "type": "string" },
        "cropBottom": { "type": "string" }, "cropLeft": { "type": "string" },
        "saveCastPath": { "type": "string" }
      }
    },
    "video": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fps": { "type": "string" }, "sleep": { "type": "string" },
        "fadeOut": { "type": "string" }, "timing": { "enum": ["deterministic", "realtime"] },
        "coalesceMs": { "type": "string" }, "loop": { "type": "boolean", "default": true }
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "savePath": { "type": "string" } }
    },
    "conversion": {
      "type": "object", "additionalProperties": false,
      "properties": { "installDependencies": { "type": "boolean" }, "svgConverter": { "enum": ["auto", "ffmpeg", "rsvg-convert", "resvg"] } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "verbose": { "type": "boolean" }, "verboseLogPath": { "type": "string" },
        "showVersion": { "type": "boolean" }, "timeout": { "type": "string" },
        "noColorEnv": { "type": "boolean" }, "noDeleteEnvs": { "type": "boolean" },
        "interactive": { "type": "boolean" }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": { "type": "string", "description": "none, macos, windows, transparent, a *-pc variant, or a chrome JSON path." },
        "padding": { "type": "number", "minimum": 0 },
        "pcMode": { "type": "boolean" },
        "pcPadding": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "theme": { "enum": ["dark", "light"] },
        "foreColor": { "type": "string" },
        "backColor": { "type": "string" },
        "background": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
        "font": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "lengthAdjust": { "enum": ["spacing", "spacingAndGlyphs"] },
        "withCommand": { "type": "boolean" },
        "header": { "type": "string" },
        "prompt": { "type": "string" }
      }
    }
  }
}
