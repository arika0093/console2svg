<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackageId>ConsoleToSvg.Core</PackageId>
    <PackageDescription>Core terminal rendering APIs for ConsoleToSvg.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="..\..\theme\built-in\**\*"
      LogicalName="theme\built-in\%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConsoleToSvg.QuickLeaks\ConsoleToSvg.QuickLeaks.csproj" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>
</Project>
