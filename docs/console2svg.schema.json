{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arika0093/console2svg/main/docs/console2svg.schema.json",
  "title": "console2svg configuration",
  "description": "Configuration consumed by console2svg --config. Command-line arguments override these values.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "include": { "type": "array", "items": { "type": "string" }, "description": "YAML files to load before this file, relative to this file." },
    "verbose": { "type": "boolean" },
    "verboseLogPath": { "type": "string" },
    "showVersion": { "type": "boolean" },
    "installDependencies": { "type": "boolean" },
    "inputCastPath": { "type": "string" },
    "outputPath": { "type": "string", "default": "output.svg" },
    "mode": { "enum": ["image", "video", "repeat"] },
    "width": { "type": "string", "description": "Positive integer or 'adjust'." },
    "height": { "type": "string", "description": "Positive integer or 'adjust'." },
    "frame": { "type": "string" },
    "time": { "type": "string", "description": "Seconds or a START-END range." },
    "cropTop": { "type": "string" },
    "cropRight": { "type": "string" },
    "cropBottom": { "type": "string" },
    "cropLeft": { "type": "string" },
    "saveCastPath": { "type": "string" },
    "replaySavePath": { "type": "string" },
    "replayPath": { "type": "string" },
    "noColorEnv": { "type": "boolean" },
    "noDeleteEnvs": { "type": "boolean" },
    "videoFps": { "type": "string" },
    "videoSleep": { "type": "string" },
    "videoFadeOut": { "type": "string" },
    "videoTiming": { "enum": ["deterministic", "realtime"] },
    "outputCoalesceMs": { "type": "string" },
    "timeout": { "type": "string" },
    "loop": { "type": "boolean", "default": true },
    "stdOut": { "type": "boolean" },
    "interactive": { "type": "boolean" },
    "saveFramesDir": { "type": "string" },
    "size": { "type": "string", "description": "WIDTH, WIDTHxHEIGHT, WIDTHx*, or *xHEIGHT." },
    "svgConverter": { "enum": ["auto", "ffmpeg", "rsvg-convert", "resvg"] },
    "appearance": { "$ref": "#/$defs/appearance" }
  },
  "$defs": {
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": { "type": "string", "description": "none, macos, windows, transparent, a *-pc variant, or a chrome JSON path." },
        "padding": { "type": "number", "minimum": 0 },
        "pcMode": { "type": "boolean" },
        "pcPadding": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "theme": { "enum": ["dark", "light"] },
        "foreColor": { "type": "string" },
        "backColor": { "type": "string" },
        "background": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
        "font": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "lengthAdjust": { "enum": ["spacing", "spacingAndGlyphs"] },
        "withCommand": { "type": "boolean" },
        "header": { "type": "string" },
        "prompt": { "type": "string" }
      }
    }
  }
}
