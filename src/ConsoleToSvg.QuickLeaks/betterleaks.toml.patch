[[rules]]
id = "console2svg-home-directory"
regex = '(?i)(?:/(?:home|Users)/[A-Za-z0-9._-]+|(?:[A-Za-z]:)?(?:\\|/)Users(?:\\|/)[A-Za-z0-9._-]+)'
early_regex = '(?i)(?:/(?:home|Users)/[A-Za-z0-9._-]*|(?:[A-Za-z]:)?(?:\\|/)Users(?:\\|/)[A-Za-z0-9._-]*)'
keywords = ["home", "users"]

[[rules]]
id = "console2svg-credential-uri"
regex = '(?i)\b[a-z][a-z0-9+.-]{1,20}://[^/\s:@]+:[^/\s@]+@'
early_regex = '(?i)\b[a-z][a-z0-9+.-]{1,20}://[^/\s:@]+:[^/\s@]*(?:@|(?=$|[\s]))'
keywords = ["://"]
